@model OYA_Web_Application.Models.Data.Dashboard.DashboardSales
@{
    var dataList = ViewBag.Contractors as List<OYA_Web_Application.Models.Data.Reports.Contractor>;
}
<style>
    .stepperActiveClass {
        color: #1b84ff !important
    }

    .hidden {
        display: none !important;
    }

    .visible {
        display: block !important;
    }
</style>
<script>
    function changeReportView(reportId) {

        document.getElementById("HeliasDailyReport").style.setProperty('display', 'none', 'important');
        document.getElementById("TerritorySalesReport").style.setProperty('display', 'none', 'important');
        document.getElementById("OyaAgingReport").style.setProperty('display', 'none', 'important');
        document.getElementById("PinoAgingReport").style.setProperty('display', 'none', 'important');
        document.getElementById("CommisionReport").style.setProperty('display', 'none', 'important');

        // var element = document.getElementById(reportId);
        var element = document.getElementById(reportId);
        if (element) {
            element.style.setProperty('display', 'block', 'important');
        }
        // $('#'+reportId).hide();
    }
</script>

