<div id="kt_app_content" class="app-content  flex-column-fluid">
    <div id="kt_app_content_container" class="app-container  container-fluid ">
        <div class="stepper stepper-pills stepper-column d-flex flex-column flex-xl-row flex-row-fluid gap-10" id="kt_create_account_stepper" data-kt-stepper="true">
            <!--begin::Aside-->
            <div class="card d-flex justify-content-center justify-content-xl-start flex-row-auto w-100">
                <!--begin::Wrapper-->
                <div class="card-header py-5">
                    <!--begin::Title-->
                    <h3 class="card-title align-items-start flex-column">
                        <span class="card-label fw-bold text-gray-900">
                            Current Sync ran at : @Model.FirstOrDefault().LastSyncedOn.ToString("MM.dd.yyyy hh:mm tt")
                        </span>
                        <br />
                        <span class="fw-semibold fs-6 text-gray-500">
                            Next sync schedule to run at : @Model.FirstOrDefault().LastSyncedOn.AddMinutes(20).ToString("MM.dd.yyyy hh:mm tt")
                        </span>
                    </h3>
                    <div>
                        <a href="/Home/SyncNow" class="btn btn-primary">Start Sync Now</a>
                    </div>  <!--end::Title-->
                </div>
                <div class="card-body px-6 px-lg-10 px-xxl-15 py-20">
                    <table class="table table-striped table-bordered">
                        <thead class="thead-dark">
                            <tr>
                                <th>
                                    #
                                </th>

                                <th>
                                    Sync Element
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Sync Status
                                </th>

                                <th>
                                    Last Synced
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        @item.SyncType
                                    </td>
                                    <td>
                                        @(item.IsActive ? "Active" : "In-Active")
                                    </td>
                                    <td>
                                        <label class="@(item.Status == "Running"? "blink":"") text-@(item.Status.ToLower() == "pending" ? "warning": item.Status.ToLower() == "failed"? "danger": "success")">@item.Status</label>
                                        <br />
                                        <small class="text-default">@item.Description</small>
                                    </td>
                                    <td>
                                        @if (item.LastSyncedOn.ToString().Contains("1900"))
                                        {
                                            <p>Never</p>
                                        }
                                        else
                                        {
                                            <p>@item.LastSyncedOn.ToString("MMM dd, yyyy hh:mm tt")</p>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!--begin::Nav-->
                </div>
            </div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()
@if (TempData["SyncPublishError"] is string publishError)
{
    <div class="alert alert-danger" role="alert">@publishError</div>
}
<div id="sync-connection-error" class="alert alert-warning" role="alert" hidden></div>
<script src="https://cdn.pubnub.com/sdk/javascript/pubnub.8.2.7.js"></script>
<script type="text/javascript">
    (() => {
        let pubnub;
        let renewalTimer;
        let refreshing = false;
        let stopped = false;
        const errorBox = document.getElementById('sync-connection-error');
        function showError(message) {
            errorBox.textContent = message;
            errorBox.hidden = false;
        }
        async function authorize() {
            if (refreshing || stopped) return;
            refreshing = true;
            clearTimeout(renewalTimer);
            try {
                const response = await fetch('@Url.Action("SyncSubscriptionToken", "Home")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });
                if (response.redirected || response.status === 401) {
                    stopped = true;
                    window.location.assign('@Url.Action("Login", "Authentication")');
                    return;
                }
                if (!response.ok) throw new Error('Live sync updates are unavailable. Refresh the page or check the server logs.');
                const access = await response.json();
                if (!pubnub) {
                    pubnub = new PubNub({ subscribeKey: access.subscribeKey, userId: access.userId });
                    pubnub.setToken(access.token);
                    pubnub.addListener({
                        message: event => {
                            if (event.message && event.message.msg === 'reload') window.location.reload();
                        },
                        status: event => {
                            if (event.category === 'PNAccessDeniedCategory' || event.error?.category === 'PNAccessDeniedCategory') {
                                showError('Renewing authorization for live sync updates...');
                                authorize();
                            } else if (event.category === 'PNConnectedCategory' || event.category === 'PNReconnectedCategory') {
                                errorBox.hidden = true;
                            } else if (event.error) {
                                showError('Live sync updates disconnected. The connection will retry.');
                            }
                        }
                    });
                    pubnub.subscribe({ channels: [access.channel] });
                } else {
                    pubnub.setToken(access.token);
                    pubnub.reconnect();
                }
                errorBox.hidden = true;
                renewalTimer = setTimeout(authorize, access.renewAfterSeconds * 1000);
            } catch (error) {
                showError(error.message || 'Live sync updates are unavailable.');
                renewalTimer = setTimeout(authorize, 30000);
            } finally {
                refreshing = false;
            }
        }
        window.addEventListener('pagehide', () => {
            stopped = true;
            clearTimeout(renewalTimer);
            if (pubnub) pubnub.destroy();
        });
        authorize();
    })();
</script>