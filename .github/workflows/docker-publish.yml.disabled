name: Docker Image CI

on:
  push:
    branches: [ master ]
    types: [ closed ]
    paths-ignore:
      - README.md
      - .vs/**
      - .gitignore

  workflow_dispatch:
  
env:
   ACTIONS_ALLOW_UNSECURE_COMMANDS: 'true'
   
jobs:
 docker:
    runs-on: upduntu-latest   
    steps:
      - name: Checkout
        uses: actions/checkout@v2

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v1

      - name: Set up Docker Buiildx
        uses: docker/setup-buildx-action@v1

      - name: Login to DockerHub
        uses: docker/login-action@v1
        with:
          username: ${{ secrets.DOCKERHU_USERNAME }}
          password: ${{ secrets.DOCKERHU_TOKEN }}

      - name: Build and push
        uses: docker/build-push-action@v2
        with:
          context: .
          file: ./OYA-Web-App/Dockerfile
          push: true
          tags: ${{ secrets.DOCKERHUB_USERNAME }}/dockerforoyawebapp:latest, ${{ secrets.DOCKERHUB_USERNAME }}/dockerforoyawebapp:${{ github.run_number }}

        
