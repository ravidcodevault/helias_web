name: OYA Simple Deploy

on:
  push:
    branches:
      - master

jobs:
  build:
    runs-on: self-hosted

    defaults:
      run:
        shell: cmd

    steps:
    - name: Checkout Code
      uses: actions/checkout@v3

    - name: Clean Build Folder
      run: |
        if exist _build rmdir /s /q _build
        mkdir _build

    - name: Restore Packages
      run: nuget restore OYA_Web_Application.sln

    - name: Build & Publish
      run: |
        msbuild OYA_Web_Application.sln ^
        /p:Configuration=Release ^
        /p:DeployOnBuild=true ^
        /p:WebPublishMethod=FileSystem ^
        /p:PublishUrl=%CD%\_build
